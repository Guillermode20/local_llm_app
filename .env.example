# Local LLM App - Environment Configuration
#
# Copy this file to .env and fill in values as needed.
# This file is checked in to document required environment variables.
# The actual .env file is gitignored.

# Path to look for GGUF model files (optional, defaults to app data dir)
# MODEL_DIRECTORY=

# Logging level: debug, info, warning, error (default: info)
# LOG_LEVEL=info

# Inference backend: auto, cpu, vulkan (default: auto)
# INFERENCE_BACKEND=auto

# Maximum context window size in tokens (default: 4096)
# MAX_CONTEXT_LENGTH=4096

# Database path (optional, defaults to app data dir)
# DATABASE_PATH=
